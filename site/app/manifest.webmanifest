    { "name": "Book a Room", "url": "/booking.html", "icons": [{ "src": "/app/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Events", "url": "/events.html", "icons": [{ "src": "/app/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
